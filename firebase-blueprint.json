{
  "entities": {
    "Shop": {
      "title": "Shop",
      "description": "Represents an individual business or store branch managed by an owner and shared with members.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique shop identifier"
        },
        "name": {
          "type": "string",
          "description": "Display name of the shop"
        },
        "description": {
          "type": "string",
          "description": "Description of the shop business"
        },
        "address": {
          "type": "string",
          "description": "Physical address of the shop"
        },
        "phone": {
          "type": "string",
          "description": "Contact phone number"
        },
        "ownerId": {
          "type": "string",
          "description": "UID of the shop owner/creator"
        },
        "ownerEmail": {
          "type": "string",
          "description": "Email address of the shop owner"
        },
        "inviteCode": {
          "type": "string",
          "description": "6-character unique join code"
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp of shop creation"
        },
        "logoUrl": {
          "type": "string",
          "description": "Optional image URL or base64 data for shop logo"
        }
      },
      "required": [
        "id",
        "name",
        "ownerId",
        "inviteCode"
      ]
    },
    "Product": {
      "title": "Product",
      "description": "Represents an inventory product in a shop.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Product name"
        },
        "qty": {
          "type": "number",
          "description": "Current quantity in stock"
        },
        "unit": {
          "type": "string",
          "description": "Unit of measurement"
        },
        "buyPrice": {
          "type": "number",
          "description": "Purchase cost per unit"
        },
        "sellPrice": {
          "type": "number",
          "description": "Selling price per unit"
        },
        "category": {
          "type": "string",
          "description": "Product category"
        },
        "packagingPrice": {
          "type": "number",
          "description": "Optional packaging cost per unit"
        },
        "color": {
          "type": "string",
          "description": "Color variation"
        }
      },
      "required": [
        "name",
        "qty",
        "buyPrice",
        "sellPrice"
      ]
    },
    "Sale": {
      "title": "Sale",
      "description": "Represents a recorded transaction/sale in a shop.",
      "type": "object",
      "properties": {
        "productId": {
          "type": "string",
          "description": "Identifier of the sold product"
        },
        "productName": {
          "type": "string",
          "description": "Name of the product at time of sale"
        },
        "qty": {
          "type": "number",
          "description": "Quantity sold"
        },
        "unit": {
          "type": "string",
          "description": "Unit sold"
        },
        "price": {
          "type": "number",
          "description": "Unit sale price"
        },
        "total": {
          "type": "number",
          "description": "Total sale amount"
        },
        "date": {
          "type": "string",
          "description": "Sale date"
        },
        "payment": {
          "type": "string",
          "description": "Payment type: cash, partial, or credit"
        },
        "paymentMethod": {
          "type": "string",
          "description": "Method used: cash, bkash, nagad, etc."
        },
        "paidAmount": {
          "type": "number",
          "description": "Amount paid"
        },
        "dueAmount": {
          "type": "number",
          "description": "Outstanding due amount"
        },
        "customer": {
          "type": "string",
          "description": "Customer name"
        },
        "customerPhone": {
          "type": "string",
          "description": "Customer phone number"
        },
        "collectionDate": {
          "type": "string",
          "description": "Date when due was paid/collected"
        },
        "collectionNotes": {
          "type": "string",
          "description": "Notes on collection"
        }
      },
      "required": [
        "productName",
        "qty",
        "price",
        "total",
        "date",
        "payment"
      ]
    },
    "Expense": {
      "title": "Expense",
      "description": "Daily business expenses such as rent, delivery fees, and utilities.",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "description": "Expense description or name"
        },
        "amount": {
          "type": "number",
          "description": "Expense amount"
        },
        "category": {
          "type": "string",
          "description": "Expense category"
        },
        "date": {
          "type": "string",
          "description": "Expense date"
        },
        "paidBy": {
          "type": "string",
          "description": "Person or account that paid"
        },
        "notes": {
          "type": "string",
          "description": "Optional notes"
        }
      },
      "required": [
        "title",
        "amount",
        "category",
        "date"
      ]
    },
    "PartnerInvestor": {
      "title": "PartnerInvestor",
      "description": "Partners and capital investors in the store.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Partner/Investor name"
        },
        "phone": {
          "type": "string",
          "description": "Contact phone"
        },
        "role": {
          "type": "string",
          "description": "partner or investor"
        },
        "committedAmount": {
          "type": "number",
          "description": "Agreed target capital"
        },
        "paidAmount": {
          "type": "number",
          "description": "Contributed capital"
        },
        "dueAmount": {
          "type": "number",
          "description": "Unpaid committed capital"
        },
        "profitShareRatio": {
          "type": "number",
          "description": "Profit share percentage"
        }
      },
      "required": [
        "name",
        "committedAmount",
        "paidAmount"
      ]
    },
    "SupplierDue": {
      "title": "SupplierDue",
      "description": "Wholesaler or supplier accounts payable records.",
      "type": "object",
      "properties": {
        "supplierName": {
          "type": "string",
          "description": "Wholesaler/Supplier name"
        },
        "phone": {
          "type": "string",
          "description": "Contact phone"
        },
        "invoiceNo": {
          "type": "string",
          "description": "Challan / Invoice number"
        },
        "totalAmount": {
          "type": "number",
          "description": "Total purchase bill"
        },
        "paidAmount": {
          "type": "number",
          "description": "Amount paid"
        },
        "dueAmount": {
          "type": "number",
          "description": "Remaining debt owed"
        },
        "purchaseDate": {
          "type": "string",
          "description": "Date of stock purchase"
        },
        "status": {
          "type": "string",
          "description": "due, partial, or paid"
        }
      },
      "required": [
        "supplierName",
        "totalAmount",
        "paidAmount",
        "purchaseDate"
      ]
    }
  },
  "firestore": {
    "/shops/{shopId}": {
      "schema": {
        "$ref": "#/entities/Shop"
      },
      "description": "Shop master documents containing metadata, members, and join requests."
    },
    "/shops/{shopId}/products/{productId}": {
      "schema": {
        "$ref": "#/entities/Product"
      },
      "description": "Products inventory collection belonging to a shop."
    },
    "/shops/{shopId}/sales/{saleId}": {
      "schema": {
        "$ref": "#/entities/Sale"
      },
      "description": "Sales records belonging to a shop."
    },
    "/shops/{shopId}/expenses/{expenseId}": {
      "schema": {
        "$ref": "#/entities/Expense"
      },
      "description": "Daily business expenses collection."
    },
    "/shops/{shopId}/partners/{partnerId}": {
      "schema": {
        "$ref": "#/entities/PartnerInvestor"
      },
      "description": "Partners and investors capital ledger."
    },
    "/shops/{shopId}/supplierDues/{supplierDueId}": {
      "schema": {
        "$ref": "#/entities/SupplierDue"
      },
      "description": "Wholesaler and supplier debts ledger."
    }
  }
}